#!/usr/bin/env bash
# Add Vader 5 Pro to your desktop: the settings window and tray icon in the app menu, and the tray
# icon at every login. No root needed; "uninstall" removes it all again.
set -euo pipefail

PROJECT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
SETTINGS_ENTRY="$APPS_DIR/vader5-settings.desktop"
TRAY_ENTRY="$APPS_DIR/vader5-tray.desktop"
TRAY_AUTOSTART="$AUTOSTART_DIR/vader5-tray.desktop"

usage() {
    cat <<EOF
Usage: $0 <command>

  install    add "Vader 5 Pro Settings" and "Vader 5 Pro Tray" to your app menu, and start the
             tray icon now and every time you log in
  uninstall  remove them and close the tray icon
EOF
}

# A quoted Exec= argument: the desktop entry spec needs quotes around paths with spaces, and % doubled.
exec_path() {
    local path=${1//%/%%}
    printf '"%s"' "${path//\"/\\\"}"
}

write_entry() {  # file, program, name, comment, extra lines
    mkdir -p "$(dirname "$1")"
    cat > "$1" <<EOF
[Desktop Entry]
Type=Application
Name=$3
Comment=$4
Exec=$(exec_path "$PROJECT_DIR/$2")
Icon=input-gaming
Terminal=false
$5
EOF
}

refresh_menu() {
    update-desktop-database "$APPS_DIR" 2>/dev/null || true
}

case "${1:-}" in
    install)
        write_entry "$SETTINGS_ENTRY" vader5-settings "Vader 5 Pro Settings" \
            "Gyro, stick and button settings for the Flydigi Vader 5 Pro" \
            "$(printf 'GenericName=Controller Settings\nCategories=Settings;HardwareSettings;\nKeywords=flydigi;vader;controller;gamepad;gyro;\nStartupWMClass=vader5-settings')"
        tray_extra="$(printf 'Categories=Utility;\nKeywords=flydigi;vader;controller;gamepad;battery;')"
        write_entry "$TRAY_ENTRY" vader5-tray "Vader 5 Pro Tray" \
            "Battery and status of the Flydigi Vader 5 Pro in the system tray" "$tray_extra"
        write_entry "$TRAY_AUTOSTART" vader5-tray "Vader 5 Pro Tray" \
            "Battery and status of the Flydigi Vader 5 Pro in the system tray" "$tray_extra"
        refresh_menu
        setsid -f "$PROJECT_DIR/vader5-tray" >/dev/null 2>&1 </dev/null || true  # does nothing if already running
        echo "Added \"Vader 5 Pro Settings\" and \"Vader 5 Pro Tray\" to your app menu; the tray icon starts at login."
        ;;
    uninstall)
        rm -f "$SETTINGS_ENTRY" "$TRAY_ENTRY" "$TRAY_AUTOSTART"
        refresh_menu
        pkill -f -- "vader5-tray" 2>/dev/null || true
        echo "Removed the Vader 5 Pro menu entries and the tray icon."
        ;;
    -h|--help) usage ;;
    *) usage; exit 1 ;;
esac
