#!/usr/bin/env bash
# Add The Tux InVader to your desktop: one app menu entry (it opens the settings window and the tray
# icon), and the tray icon at every login. No root needed; "uninstall" removes it all again.
set -euo pipefail

PROJECT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

usage() {
    cat <<USAGE
Usage: $0 <command>

  install    add "The Tux InVader" to your app menu (it opens the settings window and the tray
             icon), and start the tray icon now and every time you log in
  uninstall  remove them and close the tray icon
USAGE
}

case "${1:-}" in
    install) "$PROJECT_DIR/tux-invader" setup --only menu ;;
    uninstall) "$PROJECT_DIR/tux-invader" uninstall --only menu ;;
    -h|--help) usage ;;
    *) usage; exit 1 ;;
esac
