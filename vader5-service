#!/usr/bin/env bash
# Run vader5-pad automatically as a systemd user service (no root needed).
set -euo pipefail

UNIT=vader5-pad.service
PROJECT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

usage() {
    cat <<USAGE
Usage: $0 <command>

  install    start vader5-pad now and every time you log in
  uninstall  stop it and remove the service
  on         start it now (until you log out)
  off        stop it now (it starts again at next login; the basic Xbox pad comes back)
  restart    restart it, e.g. after updating the code
  status     show whether it's running and its latest messages
  logs       follow its messages live (Ctrl+C to stop following)
USAGE
}

case "${1:-}" in
    install) "$PROJECT_DIR/tux-invader" setup --only service ;;
    uninstall) "$PROJECT_DIR/tux-invader" uninstall --only service ;;
    on) systemctl --user start "$UNIT" ;;
    off) systemctl --user stop "$UNIT" ;;
    restart) systemctl --user restart "$UNIT" ;;
    status) systemctl --user status "$UNIT" --no-pager || true ;;
    logs) journalctl --user -u "$UNIT" -f ;;
    -h|--help) usage ;;
    *) usage; exit 1 ;;
esac
